{%- assign site_logo = section.settings.site_logo -%}

<header class="ap-site-header">
  <nav
    class="
      ap-site-header__main flex flex-wrap gap-5 justify-between items-center py-2 px-(--ap-container-gap)
      lg:py-2.5
    "
  >
    <a
      class="ap-site-logo [&_img]:w-auto [&_img]:h-20 [&_img]:object-cover [&_img]:lg:h-24"
      href="{{ routes.root_url }}"
    >
      {%- if site_logo -%}
        {{ site_logo | image_url: width: 400 | image_tag }}
      {%- else -%}
        <img src="{{ 'logo.webp' | asset_url }}" width="400" height="">
      {%- endif -%}
    </a>

    <div class="ap-site-header__menu hidden lg:block [&_ul]:flex">
      {% for link in section.settings.menu.links %}
        {{ link.title | link_to: link.url }}
      {% endfor %}
    </div>

    <div class="ap-site-header__shop-actions flex shrink-0 items-center gap-1 [&_path]:text-black">
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="header__icon header__icon--account link focus-inset{% if section.settings.menu != blank %} small-hide{% endif %}"
          rel="nofollow"
        >
          <account-icon>
            {%- if customer and customer.has_avatar? -%}
              {{ customer | avatar }}
            {%- else -%}
              <span class="svg-wrapper">{{ 'icon-user.svg' | inline_asset_content }}</span>
            {%- endif -%}
          </account-icon>
        </a>
      {%- endif -%}

      <a
        class="ap-site-header__cart [&_svg]:w-11 [&_svg]:h-11 mt-1"
        href="{{- routes.cart_url }}"
      >
        {% if cart.item_count > 0 %}
          <sup>{{ cart.item_count }}</sup>
        {% endif %}

        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>
    </div>
  </nav>
</header>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "site_logo",
      "label": "Site Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
