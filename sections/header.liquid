{%- assign site_logo = section.settings.site_logo -%}

<header class="ap-site-header">
  <nav
    class="
      ap-site-header__main flex flex-wrap gap-5 justify-between items-center py-2 px-(--ap-container-gap)
      lg:py-2.5
    "
  >
    <a
      class="ap-site-logo [&_img]:w-auto [&_img]:h-20 [&_img]:object-cover [&_img]:lg:h-24"
      href="{{ routes.root_url }}"
    >
      {%- if site_logo -%}
        {{ site_logo | image_url: width: 400 | image_tag }}
      {%- else -%}
        <img src="{{ 'logo.webp' | asset_url }}" width="400" height="">
      {%- endif -%}
    </a>

    <div class="ap-site-header__menu hidden lg:block">
      <ul class="ap-site-header__menu-list flex items-center gap-6" role="list">
        {%- for link in section.settings.menu.links -%}
          <li
            class="
              ap-site-header__menu-item relative
              {% if link.links != blank %}group/l1{% endif %}
            "
          >
            <a
              href="{{ link.url }}"
              class="
                ap-site-header__menu-link flex items-center gap-1 py-2 font-medium
                text-black transition-colors hover:text-ap-green-700
                {% if link.child_active or link.active %}is-active text-ap-green-700{% endif %}
              "
              {% if link.links != blank %}
                aria-haspopup="true" aria-expanded="false"
              {% endif %}
            >
              {{ link.title }}
              {%- if link.links != blank -%}
                <svg
                  class="ap-site-header__menu-arrow h-4 w-4 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              {%- endif -%}
            </a>

            {%- if link.links != blank -%}
              <ul
                class="
                  ap-site-header__submenu ap-site-header__submenu--level-2
                  invisible absolute left-0 top-full z-50 min-w-56
                  translate-y-2 rounded-md border border-gray-100 bg-white p-2 opacity-0
                  shadow-lg transition-all duration-200
                  group-hover/l1:visible group-hover/l1:translate-y-0 group-hover/l1:opacity-100
                "
                role="list"
              >
                {%- for childlink in link.links -%}
                  <li
                    class="
                      ap-site-header__submenu-item relative
                      {% if childlink.links != blank %}group/l2{% endif %}
                    "
                  >
                    <a
                      href="{{ childlink.url }}"
                      class="
                        ap-site-header__submenu-link flex items-center justify-between gap-2
                        rounded px-3 py-2 text-sm text-black transition-colors
                        hover:bg-ap-green-50 hover:text-ap-green-700
                        {% if childlink.child_active or childlink.active %}is-active text-ap-green-700{% endif %}
                      "
                      {% if childlink.links != blank %}
                        aria-haspopup="true" aria-expanded="false"
                      {% endif %}
                    >
                      {{ childlink.title }}
                      {%- if childlink.links != blank -%}
                        <svg
                          class="ap-site-header__submenu-arrow h-4 w-4 shrink-0 -rotate-90"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          aria-hidden="true"
                        >
                          <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      {%- endif -%}
                    </a>

                    {%- if childlink.links != blank -%}
                      <ul
                        class="
                          ap-site-header__submenu ap-site-header__submenu--level-3
                          invisible absolute left-full top-0 z-50 ml-1 min-w-56
                          -translate-x-2 rounded-md border border-gray-100 bg-white p-2 opacity-0
                          shadow-lg transition-all duration-200
                          group-hover/l2:visible group-hover/l2:translate-x-0 group-hover/l2:opacity-100
                        "
                        role="list"
                      >
                        {%- for grandchildlink in childlink.links -%}
                          <li class="ap-site-header__submenu-item">
                            <a
                              href="{{ grandchildlink.url }}"
                              class="
                                ap-site-header__submenu-link block rounded px-3 py-2 text-sm
                                text-black transition-colors
                                hover:bg-ap-green-50 hover:text-ap-green-700
                                {% if grandchildlink.active %}is-active text-ap-green-700{% endif %}
                              "
                            >
                              {{ grandchildlink.title }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="ap-site-header__shop-actions flex shrink-0 items-center gap-5 [&_path]:text-ap-green-950">
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="header__icon header__icon--account link focus-inset{% if section.settings.menu != blank %} small-hide{% endif %}"
          rel="nofollow"
        >
          <account-icon>
            {%- if customer and customer.has_avatar? -%}
              {{ customer | avatar }}
            {%- else -%}
              <span class="svg-wrapper">{{ 'icon-user.svg' | inline_asset_content }}</span>
            {%- endif -%}
          </account-icon>
        </a>
      {%- endif -%}

      <a
        class="ap-site-header__cart [&_svg]:w-6 [&_svg]:h-6"
        href="{{- routes.cart_url }}"
      >
        {% if cart.item_count > 0 %}
          <sup>{{ cart.item_count }}</sup>
        {% endif %}

        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>
    </div>
  </nav>
</header>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "site_logo",
      "label": "Site Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
