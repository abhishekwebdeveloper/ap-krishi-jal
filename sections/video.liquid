{% liquid
  assign video_source = section.settings.video_source
  assign video_media = section.settings.video
  assign video_url = section.settings.video_url
  assign poster_alt = section.settings.image.alt | default: 'Video thumbnail'

  assign has_url_video = false
  if video_url != blank
    assign has_url_video = true
  endif

  assign has_media_video = false
  if video_media != blank
    assign has_media_video = true
  endif

  assign has_video = false
  if video_source == 'url' and has_url_video
    assign has_video = true
  elsif video_source == 'media' and has_media_video
    assign has_video = true
  endif
%}

<section
  class="ap-video py-10 md:py-14"
  data-ap-video="{{ section.id }}"
>
  <div class="ap-container">
    <div
      x-data="{ playing: false }"
      class="ap-video__stage relative w-full overflow-hidden bg-ap-surface-muted rounded-xl aspect-video"
    >
      <button
        type="button"
        x-show="!playing"
        @click="playing = true"
        x-cloak
        class="group absolute inset-0 flex h-full w-full cursor-pointer items-center justify-center border-0 bg-transparent p-[unset]"
        aria-label="Play Video"
      >
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 2000
            | image_tag:
              widths: '375, 550, 750, 1100, 1500, 2000',
              sizes: '100vw',
              loading: 'lazy',
              class: 'ap-video__poster absolute inset-0 h-full w-full object-cover',
              alt: poster_alt
          }}
        {%- else -%}
          <img
            src="{{ 'product.jpg' | asset_url }}"
            alt="{{ poster_alt | escape }}"
            width="1536"
            height="1024"
            loading="lazy"
            class="ap-video__poster absolute inset-0 h-full w-full object-cover"
          >
        {%- endif -%}

        <span
          class="pointer-events-none absolute inset-0 bg-black/5 transition-colors duration-300 group-hover:bg-black/10"
        ></span>

        <span
          class="ap-video__play relative flex h-16 w-16 items-center justify-center transition-transform duration-300 group-hover:scale-110 md:h-20 md:w-20"
        >
          {{ 'icon-play.svg' | inline_asset_content }}
        </span>
      </button>

      <template x-if="playing">
        <div class="absolute inset-0 h-full w-full">
          {%- if has_video -%}
            {%- if video_source == 'url' -%}
              {%- if video_url.type == 'youtube' -%}
                <iframe
                  class="ap-video__frame h-full w-full"
                  src="https://www.youtube.com/embed/{{ video_url.id }}?autoplay=1&playsinline=1&rel=0"
                  title="{{ heading | default: 'Video' | escape }}"
                  allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              {%- elsif video_url.type == 'vimeo' -%}
                <iframe
                  class="ap-video__frame h-full w-full"
                  src="https://player.vimeo.com/video/{{ video_url.id }}?autoplay=1"
                  title="{{ heading | default: 'Video' | escape }}"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              {%- endif -%}
            {%- else -%}
              {{
                video_media
                | video_tag:
                  image_size: '1100x',
                  controls: true,
                  autoplay: true,
                  playsinline: true,
                  loop: false,
                  class: 'ap-video__frame h-full w-full object-cover'
              }}
            {%- endif -%}
          {%- endif -%}
        </div>
      </template>
    </div>
  </div>
</section>

{% stylesheet %}
  .ap-video__play svg {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(0 2px 8px rgb(0 0 0 / 25%));
  }

  .ap-video__frame {
    border: 0;
    display: block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Video source"
    },
    {
      "type": "radio",
      "id": "video_source",
      "label": "Source type",
      "options": [
        { "value": "url", "label": "Custom URL (YouTube / Vimeo)" },
        { "value": "media", "label": "Select from media library" }
      ],
      "default": "url"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video from URL",
      "accept": ["youtube", "vimeo"],
      "visible_if": "{{ section.settings.video_source == 'url' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video from media",
      "visible_if": "{{ section.settings.video_source == 'media' }}"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Cover image (thumbnail)"
    }
  ],
  "presets": [
    {
      "name": "Video"
    }
  ]
}
{% endschema %}
