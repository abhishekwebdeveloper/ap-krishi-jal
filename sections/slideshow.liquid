{% liquid
  assign speed = section.settings.speed | default: 800
  assign show_pagination = section.settings.show_pagination
%}

<div class="ap-slideshow px-(--ap-container-gap) py-5" data-ap-slideshow="{{ section.id }}">
  <div class="swiper ap-slideshow__swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide ap-slideshow__slide" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a class="ap-slideshow__link" href="{{ block.settings.link }}">
          {%- endif -%}
          {%- if block.settings.image != blank -%}
            <picture>
              {%- if block.settings.image_mobile != blank -%}
                <source
                  media="(max-width: 767px)"
                  srcset="{{ block.settings.image_mobile | image_url: width: 375 }} 375w, {{ block.settings.image_mobile | image_url: width: 550 }} 550w, {{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1024 }} 1024w"
                >
              {%- endif -%}
              {{
                block.settings.image
                | image_url: width: 2000
                | image_tag: widths: '375, 550, 750, 1100, 1500, 2000', sizes: '100vw', class: 'ap-slideshow__image'
              }}
            </picture>
          {%- else -%}
            {%- assign slide_num = forloop.index0 | modulo: 3 | plus: 1 -%}
            {%- assign hero_xl = 'hero-slide-xl-' | append: slide_num | append: '.webp' -%}
            {%- assign hero_sm = 'hero-slide-sm-' | append: slide_num | append: '.webp' -%}
            <picture>
              <source media="(max-width: 767px)" srcset="{{ hero_sm | asset_url }}" width="900" height="1601">
              <img
                src="{{ hero_xl | asset_url }}"
                alt=""
                width="1525"
                height="600"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                class="ap-slideshow__image"
              >
            </picture>
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {% endfor %}
    </div>

    {% if show_pagination %}
      <div class="swiper-pagination ap-slideshow__pagination"></div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .ap-slideshow__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    overflow: hidden;
  }

  .ap-slideshow__swiper.swiper-fade .swiper-slide {
    pointer-events: none;
  }

  .ap-slideshow__swiper.swiper-fade .swiper-slide-active {
    pointer-events: auto;
  }

  .ap-slideshow__pagination {
    --swiper-pagination-color: #3a8a3a;
    --swiper-pagination-bullet-inactive-color: #fff;
    --swiper-pagination-bullet-inactive-opacity: 0.6;
  }
{% endstylesheet %}

<script>
  (function () {
    const slideShow = document.querySelector('[data-ap-slideshow="{{ section.id }}"]');

    // Do not proceed if there is no slideshow element.
    if (!slideShow) {
      return
    };

    const slider = slideShow.querySelector('.swiper');

    // Do not proceed if there is no slide.
    if (!slider) {
      return
    }

    function init() {
      if (typeof Swiper === 'undefined') {
        return window.setTimeout(init, 50);
      }

      if (slider.swiper) {
        slider.swiper.destroy(true, true);
      }

      new Swiper(slider, {
        effect: 'fade',
        fadeEffect: { crossFade: true },
        speed: {{ speed | json }},
        loop: true,
        autoplay: {
          delay: 4000,
          disableOnInteraction: false,
          pauseOnMouseEnter: true
        },
        {% if show_pagination %}
        pagination: {
          el: slideShow.querySelector('.ap-slideshow__pagination'),
          clickable: true
        }
        {% endif %}
      });
    }

    init();

    // Re-init in the theme editor when the section is re-rendered
    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') init();
    });
  })();
</script>

{% schema %}
{
  "name": "Slideshow",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination bullets",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Transition speed",
      "unit": "ms",
      "min": 200,
      "max": 3000,
      "step": 100,
      "default": 800
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
