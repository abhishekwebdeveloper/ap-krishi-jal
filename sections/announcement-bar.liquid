{%- liquid
  assign bg_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign speed = section.settings.speed
  assign font_size = section.settings.font_size
-%}

<div
  class="ap-announcement-bar"
  style="--ap-marquee-bg-color: {{ bg_color }}; --ap-marquee-text-color: {{ text_color }}; --ap-marquee-speed: {{ speed }}s; --ap-marquee-font-size: {{ font_size }}px;"
>
  {%- if section.blocks.size > 0 -%}
    <div
      class="ap-announcement-bar__marquee"
      aria-label="Announcements"
    >
      {%- for i in (1..4) -%}
        <div
          class="ap-announcement-bar__track"
          {% if i != 1 %}
            aria-hidden="true"
          {% endif %}
        >
          {%- for block in section.blocks -%}
            <span class="ap-announcement-bar__item" {{ block.shopify_attributes }}>
              {%- if block.settings.text != blank -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">
                    {{ block.settings.text }}
                  </a>
                {%- else -%}
                  {{ block.settings.text }}
                {%- endif -%}
              {%- endif -%}
            </span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .ap-announcement-bar {
    --ap-marquee-gap: 16px;
    background-color: var(--ap-marquee-bg-color);
    color: var(--ap-marquee-text-color);
  }

  .ap-announcement-bar__marquee {
    display: flex;
    width: 100%;
    overflow: hidden;
    user-select: none;
    gap: var(--ap-marquee-gap);
  }

  .ap-announcement-bar__track {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--ap-marquee-gap);
    padding-block: 16px;
    animation: ap-marquee-scroll var(--ap-marquee-speed) linear infinite;
  }

  .ap-announcement-bar__item {
    font-size: var(--ap-marquee-font-size);
    line-height: 1.2;
    white-space: nowrap;
  }

  .ap-announcement-bar__item a {
    color: inherit;
    text-decoration: none;
  }

  .ap-announcement-bar__item a:hover {
    text-decoration: underline;
  }

  @keyframes ap-marquee-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(calc(-100% - var(--ap-marquee-gap)));
    }
  }

  .ap-announcement-bar:hover .ap-announcement-bar__track {
    animation-play-state: paused;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "ap-announcement-bar-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#D95F1C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed (seconds)",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "s",
      "default": 30
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size",
      "info": "Maximum size. Scales down fluidly on smaller screens.",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping Across India"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free Shipping Across India" } },
        {
          "type": "message",
          "settings": {
            "text": "🌿 Powered by Rare Plant-Based Omega-7 — Supporting Skin & Immunity From Within."
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "✨ Enjoy an extra 7% savings when you choose prepaid at checkout."
          }
        }
      ]
    }
  ]
}
{% endschema %}
