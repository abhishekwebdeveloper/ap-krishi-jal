{%- comment -%}
  Footer logo / brand block.

  Renders the store logo (or name as a fallback) linking home, followed by an
  optional rich-text area for a tagline or address.
{%- endcomment -%}

<div
  class="ap-footer-logo"
  style="--ap-footer-logo-width: {{ block.settings.logo_width }}px;"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.logo != blank -%}
    <a href="{{ routes.root_url }}" class="ap-footer-logo__link" aria-label="{{ shop.name | escape }}">
      {{
        block.settings.logo
        | image_url: width: 600
        | image_tag:
          loading: 'lazy',
          widths: '150, 300, 450, 600',
          sizes: 'var(--ap-footer-logo-width, 160px)',
          alt: block.settings.logo.alt | default: shop.name,
          class: 'ap-footer-logo__image'
      }}
    </a>
  {%- else -%}
    <a href="{{ routes.root_url }}" class="ap-footer-logo__link" aria-label="{{ shop.name | escape }}">
      <img
        src="{{ 'logo.webp' | asset_url }}"
        alt="{{ shop.name | escape }}"
        width="1144"
        height="712"
        loading="lazy"
        class="ap-footer-logo__image"
      >
    </a>
  {%- endif -%}

  {%- if block.settings.text != blank -%}
    <div class="ap-footer-logo__text">{{ block.settings.text }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .ap-footer-logo {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ap-footer-logo__link {
    display: inline-block;
    width: var(--ap-footer-logo-width, 160px);
    max-width: 100%;
  }

  .ap-footer-logo__image {
    width: 100%;
    height: auto;
  }

  .ap-footer-logo__name {
    font-family: var(--ap-heading-font-family);
    font-weight: var(--ap-heading-font-weight);
    font-size: var(--ap-h4-font-size);
    color: inherit;
    text-decoration: none;
  }

  .ap-footer-logo__text {
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 42ch;
  }

  .ap-footer-logo__text a {
    color: inherit;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Logo & text",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Leave empty to show the store name instead."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Tagline, address, or contact details.",
      "default": "<p><strong>KrishiJal – Healthy Soil. Stronger Crops. Better Harvests.</strong><br>\"स्वस्थ मिट्टी, बेहतर फसल, खुशहाल किसान\"</p>"
    }
  ],
  "presets": [{ "name": "Logo & text" }]
}
{% endschema %}
