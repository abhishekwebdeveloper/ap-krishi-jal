{%- comment -%}
  Footer menu column.

  Renders a heading and a list of links from a chosen menu (link list).
{%- endcomment -%}

<div class="ap-footer-menu" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <h2 class="ap-footer-menu__heading">{{ block.settings.heading }}</h2>
  {%- endif -%}

  {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
    <nav aria-label="{{ block.settings.heading | default: 'Footer menu' | escape }}">
      <ul class="ap-footer-menu__list">
        {%- for link in block.settings.menu.links -%}
          <li>
            <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}
</div>

{% stylesheet %}
  .ap-footer-menu__heading {
    font-size: var(--ap-h6-font-size);
    margin-bottom: 1rem;
    color: inherit;
  }

  .ap-footer-menu__list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ap-footer-menu__list a {
    color: inherit;
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .ap-footer-menu__list a:hover {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Menu column",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quick menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ],
  "presets": [{ "name": "Menu column" }]
}
{% endschema %}
